{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Remix",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Remix",
        "width": 1100,
        "height": 570,
        "resizable": false,
        "fullscreen": false,
        "minWidth": 1100,
        "minHeight": 570,
        "label": "main",
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "center": true,
        "backgroundColor": "#080808"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
